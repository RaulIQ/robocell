<mujoco model="panda scene">
  <include file="panda.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <default class="bin">
      <geom type="box"/>
      <default class="bin_red"><geom rgba="1 0 0 1"/></default>
      <default class="bin_green"><geom rgba="0 1 0 1"/></default>
      <default class="bin_blue"><geom rgba="0 0 1 1"/></default>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>

  <worldbody>
    <!-- конвейер -->
    <body name="conveyor_frame" pos="0.55 0 0.1">
        <geom type="box" size="0.08 0.35 0.1" rgba="0.3 0.3 0.3 1"/>
        <body name="conveyor_platform" pos="0 0 0.105">
            <joint name="conveyor" type="slide" axis="0 1 0" range="-0.25 0.25"/>
            <geom type="box" size="0.07 0.08 0.005" rgba="0.1 0.1 0.1 1"/>
        </body>
    </body>
    <!-- кубики -->
    <body name="cube_red" pos="0.55 0 0.24">
        <freejoint/>
        <geom type="box" size="0.02 0.02 0.02" mass="0.05" rgba="1 0 0 1"/>
    </body>

    <body name="cube_blue" pos="0.559076 0.230993 0.219892">
        <freejoint/>
        <geom type="box" size="0.02 0.02 0.02" mass="0.05" rgba="0 0 1 1"/>
    </body>
    
    <!-- коробки -->
    <body name="bin_red" pos="0.25 0.5 0" childclass="bin_red">
        <geom size="0.06 0.06 0.005" pos="0 0 0.005"/>
        <geom size="0.06 0.005 0.03" pos="0 0.055 0.04"/>
        <geom size="0.06 0.005 0.03" pos="0 -0.055 0.04"/>
        <geom size="0.005 0.05 0.03" pos="0.055 0 0.04"/>
        <geom size="0.005 0.05 0.03" pos="-0.055 0 0.04"/>
    </body>
    <body name="bin_green" pos="0.25 -0.5 0" childclass="bin_green">
        <geom size="0.06 0.06 0.005" pos="0 0 0.005"/>
        <geom size="0.06 0.005 0.03" pos="0 0.055 0.04"/>
        <geom size="0.06 0.005 0.03" pos="0 -0.055 0.04"/>
        <geom size="0.005 0.05 0.03" pos="0.055 0 0.04"/>
        <geom size="0.005 0.05 0.03" pos="-0.055 0 0.04"/>
    </body>
    <body name="bin_blue" pos="-0.45 0 0" childclass="bin_blue">
        <geom size="0.06 0.06 0.005" pos="0 0 0.005"/>
        <geom size="0.06 0.005 0.03" pos="0 0.055 0.04"/>
        <geom size="0.06 0.005 0.03" pos="0 -0.055 0.04"/>
        <geom size="0.005 0.05 0.03" pos="0.055 0 0.04"/>
        <geom size="0.005 0.05 0.03" pos="-0.055 0 0.04"/>
    </body>
    
    <!-- камера сверху -->
    <camera name="top" pos="0.55 0 1.2" fovy="60"/>
  </worldbody>
</mujoco>
