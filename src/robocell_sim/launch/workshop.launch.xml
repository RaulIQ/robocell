<launch>
  <!-- Simulator with its ROS 2 bridge, the IMU driver, the odometry, odom fixed where the robot starts, the URDF on simulated time, and RViz -->
  <arg name="gyro_bias" default="0.0075" description="Standard deviation in rad/s that the gyro bias of each axis is drawn from"/>
  <arg name="gyro_noise" default="0.001" description="Standard deviation in rad/s of the gyro noise on each measurement"/>
  <arg name="accelerometer_noise" default="0.02" description="Standard deviation in m/s² of the accelerometer noise on each measurement"/>
  <arg name="gyro_variance" default="$(eval '$(var gyro_noise) ** 2')" description="Gyro variance the IMU driver reports, the square of the gyro noise unless set"/>
  <arg name="accelerometer_variance" default="$(eval '$(var accelerometer_noise) ** 2')" description="Accelerometer variance the IMU driver reports, the square of the accelerometer noise unless set"/>
  <node pkg="robocell_sim" exec="main.py" output="screen">
    <param name="gyro_bias" value="$(var gyro_bias)"/>
    <param name="gyro_noise" value="$(var gyro_noise)"/>
    <param name="accelerometer_noise" value="$(var accelerometer_noise)"/>
  </node>
  <node pkg="robocell_sim" exec="imu.py" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="gyro_variance" value="$(var gyro_variance)"/>
    <param name="accelerometer_variance" value="$(var accelerometer_variance)"/>
  </node>
  <node pkg="robocell_sim" exec="odometry.py" output="screen">
    <param name="use_sim_time" value="true"/>
  </node>
  <node pkg="tf2_ros" exec="static_transform_publisher" args="--x -2.1 --y -2.5 --yaw 1.5707963267948966 --frame-id world --child-frame-id odom"/>
  <node pkg="robot_state_publisher" exec="robot_state_publisher">
    <param name="robot_description" value="$(command 'cat $(find-pkg-share robocell_sim)/models/waffle_pi/waffle_pi.urdf')"/>
    <param name="use_sim_time" value="true"/>
  </node>
  <node pkg="rviz2" exec="rviz2" args="-d $(find-pkg-share robocell_sim)/rviz/workshop.rviz">
    <param name="use_sim_time" value="true"/>
  </node>
</launch>
