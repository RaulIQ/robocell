<launch>
  <arg name="recover" default="false" description="Enable experimental recovery while mapping with depth"/>
  <arg name="localize" default="false" description="Localize against an existing RTAB-Map database"/>
  <arg name="rtabmap_database" default="$(env HOME)/.ros/robocell-rtabmap.db" description="RTAB-Map session database"/>
  <arg name="scan_source" default="lidar" description="Source of SLAM scans: lidar or depth"/>
  <arg name="fake_target" default="false" description="Enable the movable follow cube"/>
  <arg name="slam_params_file" default="$(find-pkg-share robocell_sim)/config/slam.yaml" description="SLAM configuration for lidar mapping"/>
  <arg name="rviz_config" default="$(find-pkg-share robocell_sim)/rviz/mapping.rviz" description="RViz configuration"/>
  <arg name="panel_topic" default="/cmd_vel" description="Control panel velocity topic"/>
  <arg name="rviz" default="true" description="Show the occupancy map in RViz"/>
  <arg name="headless" default="false" description="Run without the MuJoCo viewer"/>
  <arg name="teleop" default="true" description="Open the graphical control panel"/>
  <arg name="duration" default="0" description="Wall duration in seconds, zero runs until interrupted"/>
  <arg name="can_interface" default="socketcan" description="Shared python-can backend"/>
  <arg name="can_channel" default="vcan0" description="Shared CAN channel"/>
  <arg name="left_node" default="1" description="CANopen left wheel node ID"/>
  <arg name="right_node" default="2" description="CANopen right wheel node ID"/>
  <arg name="lidar_port" default="$(env HOME)/.ros/robocell-lidar" description="Shared UART endpoint"/>
  <arg name="seed" default="-1" description="IMU noise seed, negative selects a fresh seed"/>
  <include file="$(find-pkg-share robocell_sim)/launch/workshop.launch.xml">
    <arg name="fixed_odom" value="false"/>
    <arg name="scan_source" value="$(var scan_source)"/>
    <arg name="rviz_config" value="$(var rviz_config)"/>
    <arg name="panel_topic" value="$(var panel_topic)"/>
    <arg name="fake_target" value="$(var fake_target)"/>
    <arg name="rviz" value="$(var rviz)"/>
    <arg name="headless" value="$(var headless)"/>
    <arg name="teleop" value="$(var teleop)"/>
    <arg name="duration" value="$(var duration)"/>
    <arg name="can_interface" value="$(var can_interface)"/>
    <arg name="can_channel" value="$(var can_channel)"/>
    <arg name="left_node" value="$(var left_node)"/>
    <arg name="right_node" value="$(var right_node)"/>
    <arg name="lidar_port" value="$(var lidar_port)"/>
    <arg name="seed" value="$(var seed)"/>
  </include>
  <node pkg="robocell_scan" exec="slam_scan" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="input" value="$(eval &quot;'/scan/depth' if '$(var scan_source)' == 'depth' else '/scan'&quot;)"/>
    <param name="preserve_sector" value="$(eval &quot;'$(var scan_source)' == 'depth'&quot;)"/>
    <param name="capacity" value="$(eval &quot;32 if '$(var scan_source)' == 'depth' else 8&quot;)"/>
    <param name="transform_timeout" value="$(eval &quot;1.5 if '$(var scan_source)' == 'depth' else 0.5&quot;)"/>
  </node>
  <node if="$(eval &quot;'$(var scan_source)' == 'depth'&quot;)" pkg="depthimage_to_laserscan" exec="depthimage_to_laserscan_node" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="output_frame" value="camera_depth_frame"/>
    <param name="range_min" value="0.45"/>
    <param name="range_max" value="4.25"/>
    <param name="scan_height" value="33"/>
    <param name="scan_time" value="0.034"/>
    <remap from="depth" to="/camera/depth/image_raw"/>
    <remap from="depth_camera_info" to="/camera/depth/camera_info"/>
    <remap from="scan" to="/scan/depth"/>
  </node>
  <node if="$(eval &quot;'$(var scan_source)' == 'depth'&quot;)" pkg="depth_image_proc" exec="register_node" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="queue_size" value="10"/>
    <remap from="depth/image_rect" to="/camera/depth/image_raw"/>
    <remap from="depth/camera_info" to="/camera/depth/camera_info"/>
    <remap from="rgb/camera_info" to="/camera/camera_info"/>
    <remap from="depth_registered/image_rect" to="/camera/depth_registered/image_raw"/>
  </node>
  <node if="$(eval &quot;'$(var scan_source)' == 'depth'&quot;)" pkg="rtabmap_sync" exec="rgbd_sync" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="approx_sync" value="false"/>
    <param name="decimation" value="2"/>
    <param name="qos" value="2"/>
    <param name="qos_camera_info" value="1"/>
    <param name="sync_queue_size" value="10"/>
    <remap from="rgb/image" to="/camera/image_raw"/>
    <remap from="depth/image" to="/camera/depth_registered/image_raw"/>
    <remap from="rgb/camera_info" to="/camera/camera_info"/>
    <remap from="rgbd_image" to="/camera/rgbd_image"/>
  </node>
  <node if="$(eval &quot;'$(var scan_source)' == 'depth'&quot;)" pkg="rtabmap_odom" exec="rgbd_odometry" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="frame_id" value="base_footprint"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="publish_tf" value="false"/>
    <param name="publish_null_when_lost" value="false"/>
    <param name="subscribe_rgbd" value="true"/>
    <param name="approx_sync" value="false"/>
    <param name="qos" value="2"/>
    <param name="qos_camera_info" value="1"/>
    <param name="wait_for_transform" value="0.5"/>
    <param name="max_update_rate" value="15.0"/>
    <param name="frame_policy" value="1"/>
    <param name="output_queue_size" value="5"/>
    <param name="Odom/ResetCountdown" value="'1'"/>
    <remap from="rgbd_image" to="/camera/rgbd_image"/>
    <remap from="odom" to="/visual/odometry"/>
  </node>
  <node if="$(eval &quot;'$(var scan_source)' == 'depth'&quot;)" pkg="rtabmap_slam" exec="rtabmap" output="screen">
    <param name="use_sim_time" value="true"/>
    <param name="frame_id" value="base_footprint"/>
    <param name="odom_frame_id" value="odom"/>
    <param name="map_frame_id" value="map"/>
    <param name="publish_tf" value="true"/>
    <param name="subscribe_depth" value="false"/>
    <param name="subscribe_rgbd" value="true"/>
    <param name="subscribe_scan" value="true"/>
    <param name="qos_scan" value="2"/>
    <param name="approx_sync" value="false"/>
    <param name="odom_sensor_sync" value="true"/>
    <param name="wait_for_transform" value="0.5"/>
    <param name="database_path" value="$(var rtabmap_database)"/>
    <param name="Mem/IncrementalMemory" value="'$(eval &quot;'false' if '$(var localize)' == 'true' else 'true'&quot;)'"/>
    <param name="Mem/InitWMWithAllNodes" value="'$(eval &quot;'true' if '$(var localize)' == 'true' else 'false'&quot;)'"/>
    <param name="RGBD/StartAtOrigin" value="'$(eval &quot;'true' if '$(var localize)' == 'true' else 'false'&quot;)'"/>
    <param name="RGBD/ProximityPathMaxNeighbors" value="'10'"/>
    <param name="RGBD/ProximityMaxPaths" value="'$(eval &quot;'1' if '$(var localize)' == 'true' else '3'&quot;)'"/>
    <param name="RGBD/ProximityGlobalScanMap" value="'$(eval &quot;'true' if '$(var recover)' == 'true' else 'false'&quot;)'"/>
    <param name="RGBD/NeighborLinkRefining" value="'True'"/>
    <param name="Reg/Strategy" value="'1'"/>
    <param name="Reg/Force3DoF" value="'true'"/>
    <param name="Optimizer/GravitySigma" value="'0'"/>
    <param name="Icp/MaxCorrespondenceDistance" value="'$(eval &quot;'0.2' if '$(var localize)' == 'true' or '$(var recover)' == 'true' else '0.1'&quot;)'"/>
    <param name="Icp/MaxTranslation" value="'$(eval &quot;'1.0' if '$(var localize)' == 'true' or '$(var recover)' == 'true' else '0.2'&quot;)'"/>
    <param name="Icp/MaxRotation" value="'$(eval &quot;'0.15' if '$(var localize)' == 'true' or '$(var recover)' == 'true' else '0.78'&quot;)'"/>
    <param name="Icp/PointToPlane" value="'$(eval &quot;'false' if '$(var localize)' == 'true' or '$(var recover)' == 'true' else 'true'&quot;)'"/>
    <param name="qos_image" value="2"/>
    <param name="qos_camera_info" value="1"/>
    <param name="qos_odom" value="1"/>
    <param name="Rtabmap/DetectionRate" value="'1.0'"/>
    <param name="Grid/3D" value="'false'"/>
    <param name="Grid/Sensor" value="'2'"/>
    <param name="Grid/RangeMax" value="'3.0'"/>
    <param name="Grid/NormalsSegmentation" value="'false'"/>
    <param name="Grid/MaxGroundHeight" value="'0.02'"/>
    <param name="Grid/MaxObstacleHeight" value="'0.4'"/>
    <param name="Grid/RayTracing" value="'true'"/>
    <remap from="rgbd_image" to="/camera/rgbd_image"/>
    <remap from="odom" to="/odometry/filtered"/>
    <remap from="scan" to="/scan/slam"/>
  </node>
  <node if="$(eval &quot;'$(var scan_source)' == 'depth' and '$(var localize)' == 'false' and '$(var recover)' == 'true'&quot;)" pkg="robocell_sim" exec="recover.py" output="screen">
    <param name="use_sim_time" value="true"/>
  </node>
  <include if="$(eval &quot;'$(var scan_source)' == 'lidar'&quot;)" file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
    <arg name="autostart" value="true"/>
    <arg name="use_lifecycle_manager" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="slam_params_file" value="$(var slam_params_file)"/>
  </include>
</launch>
