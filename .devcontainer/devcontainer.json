{
  "name": "robocell",
  "dockerComposeFile": "../compose.yaml",
  "service": "dev",
  "workspaceFolder": "/ws",
  "shutdownAction": "none",
  "remoteUser": "ubuntu",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.analysis.extraPaths": [
          "/opt/ros/jazzy/lib/python3.12/site-packages"
        ]
      }
    }
  }
}
