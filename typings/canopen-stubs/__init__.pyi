from can import BusABC
from canopen.objectdictionary import ObjectDictionary as ObjectDictionary

class Network:
    def __init__(self, bus: BusABC) -> None: ...
    def add_node(self, node: LocalNode) -> LocalNode: ...
    def send_message(self, can_id: int, data: bytes) -> None: ...

class NmtSlave:
    state: str
    def send_command(self, code: int) -> None: ...
    def on_command(self, can_id: int, data: bytearray, timestamp: float) -> None: ...
    def stop_heartbeat(self) -> None: ...

class SdoServer:
    def on_request(self, can_id: int, data: bytearray, timestamp: float) -> None: ...

class EmcyProducer:
    def send(self, code: int, register: int) -> None: ...

class LocalNode:
    id: int
    nmt: NmtSlave
    sdo: SdoServer
    emcy: EmcyProducer
    network: Network
    data_store: dict[int, dict[int, bytes]]
    object_dictionary: ObjectDictionary
    def __init__(self, node_id: int, object_dictionary: ObjectDictionary) -> None: ...
    def associate_network(self, network: Network) -> None: ...
    def remove_network(self) -> None: ...
    def get_data(self, index: int, subindex: int, check_readable: bool = False) -> bytes: ...
    def set_data(self, index: int, subindex: int, data: bytes, check_writable: bool = False) -> None: ...
